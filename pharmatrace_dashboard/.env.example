# Leave empty in dev (Vite proxies /api to localhost:3000)
# In production, set to the deployed API origin, e.g. https://api.example.com/api
VITE_API_URL=

# Dev only. Where `npm run dev` sends /api calls. Leave empty to use the server on your laptop (http://localhost:3000)
# To use the hosted backend instead (so you do not have to start node server.js), set it in .env.local:
# VITE_DEV_API=https://pharmatrace-bf19.onrender.com
VITE_DEV_API=

# Build time. Makes every transaction hash a link to a block explorer. Leave empty on a local chain.
# VITE_EXPLORER_URL=https://sepolia.etherscan.io
VITE_EXPLORER_URL=
