# ---------------------------------------------------------------------------------------------
# Needed by the running server (on your laptop and on Render)
# ---------------------------------------------------------------------------------------------
PORT=                         # Render sets this itself. Only set it locally if you do not want 3000.
DATABASE_URL=                 # Neon connection string
JWT_SECRET=                   # a long random string

# Flag-report photos (Neon Object Storage)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Blockchain
CHAIN_NETWORK=sepolia         # reads pharmatrace_backend/chain-sepolia/. Leave empty for the local Hardhat chain.
RPC_URL=                      # your Alchemy Sepolia address. Keep it private.
CHAIN_READS=                  # "off" answers scans from the database only. Anything else (or empty) also asks the chain.

# Links in QR codes and emails
PUBLIC_BASE_URL=              # this server's own address, for example https://pharmatrace-v2.onrender.com
DASHBOARD_URL=                # the dashboard's address, used in welcome and password-reset emails

# Email (Brevo)
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------
# ALLOWED_ORIGINS=http://localhost:5173   # CORS. Only matters when a browser calls the server directly (local development).
# PUBLIC_RPC_URL=                         # public node address sent to browsers. Defaults to a public Sepolia node.
# EXPLORER_URL=                           # block explorer address. Defaults to Etherscan on Sepolia.
# DISPLAY_TIMEZONE=                       # for dates shown in reports
# ANALYTICS_BURST_MIN=                    # minutes used to group a burst of scans

# ---------------------------------------------------------------------------------------------
# Setup scripts. Run by hand on your laptop, never read by the server. Do NOT put these on Render.
# ---------------------------------------------------------------------------------------------
# scripts/seedSuperAdmin.js
# SEED_NAME=
# SEED_CONTACT=
# SEED_PASSWORD=
# SEED_WALLET=
# scripts/seedDemoAccounts.js (local Hardhat chain only)
# REGULATOR_CONTACT=
# REGULATOR_PASSWORD=
# MANUFACTURER_CONTACT=
# MANUFACTURER_PASSWORD=
# scripts/seedDemoData.js
# SEED_MANUFACTURER_PASSWORD=
